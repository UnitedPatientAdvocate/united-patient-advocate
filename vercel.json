{
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/",
      "dest": "/UPA-Final/01_upa-landing.html"
    },
    {
      "src": "/index\\.html",
      "dest": "/UPA-Final/01_upa-landing.html"
    },
    {
      "src": "/success/?",
      "dest": "/UPA-Final/05_upa-success.html"
    },
    {
      "src": "/checkout/?",
      "dest": "/UPA-Final/06_upa-checkout.html"
    },
    {
      "src": "/dashboard/?",
      "dest": "/UPA-Final/04_upa-dashboard.html"
    },
    {
      "src": "/upa-premium-v10\\.5\\.html",
      "dest": "/UPA-Final/04_upa-dashboard.html"
    },
    {
      "src": "/upa-preview\\.html",
      "dest": "/UPA-Final/03_upa-preview.html"
    },
    {
      "src": "/mission-control\\.html",
      "dest": "/UPA-Final/mission-control.html"
    },
    {
      "src": "/mission-control-live\\.html",
      "dest": "/UPA-Final/mission-control-live.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
